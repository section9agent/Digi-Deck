{
  "name": "digi-deck",
  "version": "2.0.0",
  "description": "Digi-Deck - a vinyl / CD / cassette media player with per-format libraries",
  "main": "src/main/main.js",
  "author": "Emmanuel Hoachlander",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:win:portable": "electron-builder --win portable --x64",
    "dist:dir": "electron-builder --dir",
    "notices": "node scripts/notices.js",
    "predist": "node scripts/check-prebuilt.js",
    "predist:win": "node scripts/check-prebuilt.js",
    "predist:win:portable": "node scripts/check-prebuilt.js",
    "predist:dir": "node scripts/check-prebuilt.js",
    "check-prebuilt": "node scripts/check-prebuilt.js",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.2.0",
    "music-metadata": "7.14.0"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.digideck.player",
    "productName": "Digi-Deck",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "!assets/micro/prebuilt/**",
      "!assets/_silver/**",
      "!assets/_tinted/**",
      "!assets/_mats/**"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "icon": "build/icon.png",
      "maintainer": "Digi-Deck <digi-deck@users.noreply.github.com>",
      "synopsis": "A vinyl / CD / cassette / MiniDisc / DAT media player"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "YOUR-GITHUB-USERNAME",
        "repo": "digi-deck",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "extraResources": [
      {
        "from": "assets/micro/prebuilt",
        "to": "prebuilt-micro",
        "filter": [
          "albums.json",
          "*.png",
          "*.jpg",
          "*.jpeg",
          "*.webp"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR-GITHUB-USERNAME/digi-deck.git"
  }
}
